# RehabCore – zmienne środowiskowe (demo)
# W trybie demo aplikacja nie wymaga backendu ani kluczy API.

# Opcjonalnie: base URL API (gdy podłączysz backend)
# VITE_API_URL=https://api.example.com

# Opcjonalnie: Booksy URL (link do rezerwacji wizyt)
# Domyślnie używany jest stały link w mockData.js

# Wymagane dla /api/waitlist (zapis do listy oczekujących MOTIVO).
# Ustaw w Vercel → Project Settings → Environment Variables (NIE w .env,
# nie commituj prawdziwych wartości). SUPABASE_SERVICE_ROLE_KEY i BREVO_API_KEY
# to sekrety — używane wyłącznie server-side w api/waitlist.js, nigdy w kodzie
# frontendu (nigdy z prefiksem VITE_).
# SUPABASE_URL=https://vxojagewdhefllyomrax.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Brevo — zapis kontaktów z waitlisty MOTIVO (Contacts API).
# BREVO_API_KEY: Brevo → Settings → SMTP & API → API Keys → wygeneruj klucz.
# BREVO_WAITLIST_ID: Brevo → Contacts → Lists → wejdź na listę "MOTIVO
# Waitlista" → ID listy jest widoczne w adresie URL / szczegółach listy.
# BREVO_API_KEY=
# BREVO_WAITLIST_ID=
